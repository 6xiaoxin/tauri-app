{
  "name": "tauri-enterprise-app",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Tauri desktop application scaffold",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm quality && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "fix": "pnpm format && pnpm lint:fix && pnpm stylelint:fix && pnpm typecheck",
    "quality": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm rust:fmt:check && pnpm rust:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "axios": "1.19.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.0",
    "vue-tsc": "3.3.8"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --max-warnings=0",
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,html}": "prettier --write",
    "src-tauri/**/*.rs": "rustfmt --edition 2024"
  }
}
